---
import PageLayout from '../layouts/PageLayout.astro';
const faqs = [
  { q: 'Do I need an account?', a: 'No. DIVERTI does not require an account or login.' },
  { q: 'Where is my tracking information stored?', a: 'Your entries are stored locally on your iPhone. DIVERTI does not currently sync your records to a DIVERTI cloud account.' },
  { q: 'How do food search and barcode scanning work?', a: 'When you look up a food, your search term or scanned barcode may be sent to Open Food Facts and/or DIVERTI’s USDA lookup service to retrieve food information. Your journal entries and personal goals are not included in these lookup requests.' },
  { q: 'Can I export my information?', a: 'Yes. You can create CSV data exports and PDF clinician reports. These files may include personal entries and notes, so choose carefully where you share them. CSV and PDF exports are not restorable DIVERTI backups.' },
  { q: 'What does Delete All remove?', a: 'Delete All clears your journal entries and notes, saved foods, favorites, nutrition evidence, goal history, and hydration preferences. It also tries to clean up recognized inactive temporary export and backup files. It cannot remove Apple-managed backups, copies you already shared, or files kept by other apps.' },
  { q: 'Can I restore my data or move it to a new iPhone?', a: 'DIVERTI does not currently offer its own backup or restore feature. Apple-managed backups may include app data depending on your settings. CSV and PDF exports are for viewing or sharing and cannot be restored into DIVERTI.' },
  { q: 'Can DIVERTI give me medical advice?', a: 'No. DIVERTI helps you keep personal records. It does not diagnose or treat health conditions and is not a substitute for professional medical advice.' },
  { q: 'When will TestFlight be available?', a: 'DIVERTI is preparing for an initial TestFlight release. Availability and invitations are not yet confirmed; please check back for updates.' },
  { q: 'Can Support delete my journal remotely?', a: 'No. Your journal database stays on your iPhone, and Support cannot remotely access or delete it. Use Delete All in the app to clear your records.' },
];
---
<PageLayout
  title="Support — DIVERTI"
  description="Answers to common questions about DIVERTI, plus a direct way to contact support."
>
  <div class="support-page">
    <section class="support-intro shell">
      <div class="intro-copy">
        <p class="eyebrow">Here to help</p>
        <h1>A little help,<br /><em>when you need it.</em></h1>
        <p class="lede">Find a quick answer below, or get in touch with the DIVERTI team. We’re glad to help.</p>
      </div>
      <aside class="contact-note">
        <span class="contact-kicker">Have a question?</span>
        <a href="mailto:support@diverti.app">Email DIVERTI Support <span aria-hidden="true">↗</span></a>
        <p>Please don’t include sensitive health records or screenshots unless they’re needed to explain a technical issue.</p>
      </aside>
    </section>

    <section class="faq-section shell" aria-labelledby="faq-title">
      <div class="faq-heading">
        <p class="eyebrow">Common questions</p>
        <h2 id="faq-title">Good to <em>know.</em></h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-item">
            <summary><span class="faq-number">{String(index + 1).padStart(2, '0')}</span><span>{faq.q}</span><span class="faq-toggle" aria-hidden="true"></span></summary>
            <div class="faq-answer"><p>{faq.a}</p></div>
          </details>
        ))}
      </div>
    </section>

    <section class="support-close">
      <div class="shell close-inner">
        <p class="eyebrow">Still have a question?</p>
        <h2>We’re only an<br /><em>email away.</em></h2>
        <a class="button" href="mailto:support@diverti.app">support@diverti.app <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .support-intro { display: grid; grid-template-columns: 1.15fr .75fr; align-items: end; gap: 10%; padding-block: clamp(62px, 9vw, 110px) clamp(68px, 9vw, 105px); }
  .eyebrow { margin: 0 0 20px; color: var(--eucalyptus); font-size: .75rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  h1, h2 { font-family: var(--serif); font-weight: 400; letter-spacing: -.055em; }
  h1 { margin: 0; font-size: clamp(3.5rem, 7.5vw, 6rem); line-height: .97; }
  h1 em, h2 em { color: var(--eucalyptus); font-style: italic; }
  .lede { max-width: 515px; margin: 24px 0 0; color: var(--muted); font-size: 1.1rem; line-height: 1.75; }
  .contact-note { padding: 25px 0 4px 26px; border-left: 1px solid var(--sage); }
  .contact-kicker { display: block; margin-bottom: 12px; color: var(--muted); font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; }
  .contact-note > a { color: var(--eucalyptus); font-family: var(--serif); font-size: clamp(1.35rem, 2.5vw, 1.8rem); text-decoration-color: var(--sage); text-underline-offset: 5px; }
  .contact-note > a span { margin-left: 6px; color: var(--clay); font-family: var(--sans); font-size: .85rem; }
  .contact-note p { max-width: 340px; margin: 14px 0 0; color: var(--muted); font-size: .88rem; line-height: 1.65; }
  .faq-section { display: grid; grid-template-columns: .65fr 1.35fr; gap: 9%; padding-block: clamp(58px, 8vw, 95px) clamp(80px, 10vw, 125px); border-top: 1px solid var(--line); }
  .faq-heading { align-self: start; position: sticky; top: 40px; }
  .faq-heading h2 { margin: 0; font-size: clamp(2.7rem, 5vw, 4.3rem); line-height: 1; }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-item summary { min-height: 74px; display: grid; grid-template-columns: 34px 1fr 22px; align-items: center; gap: 13px; cursor: pointer; list-style: none; font-size: 1rem; font-weight: 600; line-height: 1.45; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-number { color: var(--clay); font-size: .7rem; font-weight: 600; letter-spacing: .08em; }
  .faq-toggle { position: relative; width: 18px; height: 18px; }
  .faq-toggle::before, .faq-toggle::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 1px; background: var(--eucalyptus); transform: translate(-50%, -50%); }
  .faq-toggle::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform .2s ease; }
  details[open] .faq-toggle::after { transform: translate(-50%, -50%) rotate(0); }
  .faq-item summary:focus-visible { outline: 3px solid var(--clay); outline-offset: 3px; border-radius: 2px; }
  .faq-answer { padding: 0 35px 23px 47px; }
  .faq-answer p { max-width: 640px; margin: 0; color: var(--muted); font-size: 1rem; line-height: 1.7; }
  .support-close { padding-block: clamp(76px, 10vw, 120px); background: #E8EAE1; text-align: center; }
  .close-inner { display: flex; flex-direction: column; align-items: center; }
  .support-close .eyebrow { margin-bottom: 16px; }
  .support-close h2 { margin: 0; font-size: clamp(3.3rem, 6.5vw, 5.5rem); line-height: .98; }
  .button { min-height: 54px; display: inline-flex; align-items: center; justify-content: center; gap: 18px; margin-top: 28px; padding: 0 23px; border: 1px solid var(--eucalyptus); border-radius: 4px; color: var(--eucalyptus); font-size: .92rem; font-weight: 600; text-decoration: none; transition: transform .18s ease, background-color .18s ease, color .18s ease; }
  .button:hover { transform: translateY(-2px); background: var(--eucalyptus); color: var(--cream); }
  @media (max-width: 760px) {
    .support-intro { grid-template-columns: 1fr; gap: 34px; padding-top: 56px; }
    .contact-note { max-width: 500px; }
    .faq-section { grid-template-columns: 1fr; gap: 29px; }
    .faq-heading { position: static; }
  }
  @media (max-width: 390px) {
    .faq-item summary { grid-template-columns: 27px 1fr 20px; gap: 10px; font-size: .95rem; }
    .faq-answer { padding-left: 37px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-toggle::after, .button { transition: none; }
  }
</style>
